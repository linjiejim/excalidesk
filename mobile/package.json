{
  "name": "excalidesk-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first Expo iOS viewer for Excalidraw drawings in iCloud Drive and Excalidesk share links",
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "prebuild:ios": "expo prebuild --platform ios",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test __tests__/*.test.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~52.0.0",
    "expo-document-picker": "~13.0.0",
    "expo-file-system": "~18.0.0",
    "expo-linking": "~7.0.0",
    "expo-sharing": "~13.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.6",
    "react-native-safe-area-context": "4.12.0",
    "react-native-svg": "15.8.0",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/config-plugins": "~9.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.12",
    "typescript": "~5.7.3"
  }
}
